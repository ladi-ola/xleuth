# Placeholder values only. Never commit real secrets here.
# ── Polymarket Data Sources ──────────────────────────────
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com

# ── Index Computation & Liquidity Filter ─────────────────
MIN_MARKET_VOLUME_USD=5000
MIN_MARKET_LIQUIDITY_SCORE=0.3
EXCLUDE_CATEGORIES=sports
ACTIVE_BASKETS=TOP50-JULY,TOP50-AUGUST
BASKET_SIZE_DEFAULT=50
INGESTION_POLL_INTERVAL_SECONDS=30
INDEX_PRICE_SCALE=100

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://xleuth_app:changeme_local_dev_password@localhost:5432/xleuth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xleuth
POSTGRES_USER=xleuth_app
POSTGRES_PASSWORD=changeme_local_dev_password
