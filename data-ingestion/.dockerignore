# Keep the build context small and free of local artefacts. The build context is
# this service's directory, so stray files here are sent on every build.
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
diagnose_dates.py
diagnose_dates2.py
*.log
.env
.env.*
!.env.example