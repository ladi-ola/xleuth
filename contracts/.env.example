# Placeholder values only. Never commit real secrets here.
# Copy to contracts/.env and fill in real values (contracts/.env is gitignored).

# ── Chain (Polygon Amoy testnet) ─────────────────────────
CHAIN_ID=80002
RPC_URL=https://polygon-amoy.drpc.org
DEPLOYER_PRIVATE_KEY=changeme_your_deployer_key

# ── Deployed contract addresses (filled in after deploy) ─
COLLATERAL_VAULT_ADDRESS=
POSITION_MANAGER_ADDRESS=
INDEX_ORACLE_CONSUMER_ADDRESS=
SETTLEMENT_ENGINE_ADDRESS=

# ── Token / Oracle configuration ────────────────────────
# Test-USDC on Amoy (fill after minting; if left empty, the deploy script
# deploys a fresh MockUSDC and wires it in — dev only, never mainnet).
TEST_USDC_ADDRESS=
# EOA that signs index price updates consumed by IndexOracleConsumer
# (week 4's oracle-service key). If empty, deploy script uses DEPLOYER_PRIVATE_KEY.
ORACLE_SIGNER_PRIVATE_KEY=
# EOA that signs basket settlement (realized-fraction) messages consumed by
# SettlementEngine. If empty, deploy script uses DEPLOYER_PRIVATE_KEY.
SETTLEMENT_SIGNER_PRIVATE_KEY=

# ── Contract parameters ──────────────────────────────────
MAX_LEVERAGE=5
MAX_PRICE_STALENESS_SECONDS=60
INDEX_PRICE_SCALE=100
MAINTENANCE_MARGIN_RATIO_BPS=625
LIQUIDATION_FEE_BPS=50
# Max age (s) of a signed settlement message accepted by SettlementEngine.
SETTLEMENT_MAX_STALENESS_SECONDS=3600
# Optional: register every ACTIVE_BASKETS expiry at deploy time (unix seconds).
# If 0, no basket expiry is registered (ConfigureBaskets must do it later).
BASKET_EXPIRY_SECONDS=0

# ── Basket seeding (ConfigureBaskets.s.sol) ──────────────
# Month templates ({MONTH}) are expanded by the script to the current month
# (active) and the next month (upcoming/prepped), e.g. TOP20-AUGUST,
# TOP20-SEPTEMBER. Literal dated names are also accepted.
ACTIVE_BASKETS=TOP20-{MONTH}
# Optional: comma-separated seed prices, same length as the expanded basket
# list. If empty, every basket is seeded at price 50.
BASKET_INITIAL_PRICES=
