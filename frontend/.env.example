# Dynamic.xyz environment ID (get from https://app.dynamic.xyz)
VITE_DYNAMIC_ENVIRONMENT_ID=

# Backend API base URL (no trailing slash)
VITE_BACKEND_API_URL=http://localhost:8000

# Matching Engine base URL (no trailing slash)
VITE_MATCHING_ENGINE_URL=http://localhost:8001

# WebSocket base URLs (ws:// or wss://)
VITE_BACKEND_WS_URL=ws://localhost:8000
VITE_MATCHING_WS_URL=ws://localhost:8001

# Chain configuration
VITE_CHAIN_ID=80002
VITE_CHAIN_NAME=Polygon Amoy
VITE_CHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Test-USDC collateral token used by the CollateralVault (6 decimals).
# This is the token the faucet dispenses and the vault accepts.
VITE_COLLATERAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000001

# CollateralVault the matching engine reads. Deposits must go here.
VITE_COLLATERAL_VAULT_ADDRESS=0x0000000000000000000000000000000000000002

# Legacy alias kept for older deployments; the app prefers
# VITE_COLLATERAL_TOKEN_ADDRESS and ignores the known-dead USDC value.
VITE_USDC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000003

# Faucet wallet address (reserve)
VITE_FAUCET_WALLET_ADDRESS=0x0000000000000000000000000000000000000004

# SEO/indexing (tasks 6+9): testnet default is noindex. One-line switch:
# VITE_ROBOTS_CONTENT="index, follow". VITE_PUBLIC_SITE_URL feeds
# canonical/OG tags (empty = tags omitted).
VITE_ROBOTS_CONTENT=noindex, nofollow
VITE_PUBLIC_SITE_URL=

# Cookieless analytics (task 17): both required, else nothing fires.
# VITE_ANALYTICS_URL=
# VITE_ANALYTICS_SITE=