      "get": {
        "tags": [
          "accounts"
        ],
        "summary": "Get Summary",
        "description": "Get portfolio summary with margin breakdown.\n\nfree_margin = free vault balance (after resting-order locks)\nused_margin = margin locked by open positions + margin reserved for resting orders\ntotal_balance = free_margin + used_margin\nSL/TP orders carry no separate reservation",
        "operationId": "get_summary_accounts_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
