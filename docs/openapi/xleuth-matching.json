{
  "openapi": "3.1.0",
  "info": {
    "title": "Xleuth Matching Engine",
    "description": "Legacy matching HTTP surface. POST /orders is safety-paused while the legacy per-trader settlement bridge is configured: HTTP 503 with detail legacy_settlement_disabled. V2 trader-signed atomic execution requires an integrated funded ledger and durable coordinator before activation.",
    "version": "0.1.0"
  },
  "paths": {
    "/orders": {
      "post": {
        "summary": "Place Order",
        "operationId": "place_order_orders_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "503": {
            "description": "Legacy per-trader settlement is disabled; detail: legacy_settlement_disabled"
          }
        }
      },
      "get": {
        "summary": "List Orders",
        "description": "List orders for the authenticated trader.\n\nQuery params:\n- status: \"open\" (default) = open, partially_filled, plus resting stop/SL/TP\n          \"history\" = filled, cancelled, rejected, triggered\n          \"all\" = all orders\n- basket_name: optional filter by basket\n- limit: max results (default 50, max 200)\n- cursor: order_id for pagination (returns orders older than this)",
        "operationId": "list_orders_orders_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "basket_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Basket Name"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
